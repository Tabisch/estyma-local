# Copy to .env (never commit .env). See "Environment variables" in README.md.

# Host ports
PROXY_PORT=8088
UI_PORT=8089

# Cloud recorder (idles if these are empty)
ESTYMA_EMAIL=you@example.com
ESTYMA_PASSWORD=change-me
# If the password starts or ends with a space, leave ESTYMA_PASSWORD empty and
# set its base64 instead:  printf ' my password' | base64
ESTYMA_PASSWORD_B64=

# Optional basic auth for the log web UI (port 8089)
UI_USER=
UI_PASSWORD=

# Local server (see "Operating modes" in README.md)
MODE=proxy
WRITES_ENABLED=0
ALLOW_POWER_WRITES=0
LOCAL_FALLBACK=0
CLOUD_MIRROR=0
CONTROLLER_TZ=Europe/Warsaw
