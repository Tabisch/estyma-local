# Copy to .env (never commit .env). See "Environment variables" in README.md.

# Host ports
PROXY_PORT=8088
UI_PORT=8089

# Optional basic auth for the log web UI (port 8089). Also needed to switch
# cloud monitoring and to delete logs from the UI.
UI_USER=
UI_PASSWORD=

# Optional cloud monitoring (switched on/off in the web UI)
ESTYMA_EMAIL=
ESTYMA_PASSWORD=
# If the password starts or ends with a space, leave ESTYMA_PASSWORD empty and
# set its base64 instead:  printf ' my password' | base64
ESTYMA_PASSWORD_B64=

# Local server (see "Operating modes" in README.md)
MODE=proxy
WRITES_ENABLED=0
ALLOW_POWER_WRITES=0
LOCAL_FALLBACK=0
CLOUD_MIRROR=0
CONTROLLER_TZ=Europe/Warsaw
