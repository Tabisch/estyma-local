# Generated by estyma_local/gendocs.py from estyma_local/config.py. Do not edit by hand.
# Copy to .env (never commit .env). See docs/configuration.md.

# Proxy
# Web UI port. Inside the container 0 turns the UI off; in docker-compose.yml it is the host port (inside it stays 8089)
UI_PORT=8089
# Basic auth user for the web UI. Also needed for writes, switching cloud monitoring and deleting logs
UI_USER=
# Basic auth password; auth is on only when user and password are both set
UI_PASSWORD=
# Delete .jsonl logs older than this many days, 0 = keep them all. Only the initial state: once it is changed on the settings page, the page's choice is kept in log-retention.json
LOG_RETENTION_DAYS=0

# Local server
# proxy, hybrid or local
MODE=proxy
# 1 = allow local writes (boiler target)
WRITES_ENABLED=0
# 1 = also allow switching the boiler on/off; needs WRITES_ENABLED=1
ALLOW_POWER_WRITES=0
# 1 = also allow the settings whose write path is untested (all but boiler target and on/off); needs WRITES_ENABLED=1
ALLOW_UNTESTED_WRITES=0
# Minutes between reads of all settings in hybrid/local, 0 = only on start and on request
SETTINGS_READ_MINUTES=60
# 1 = in proxy/hybrid, answer locally when the cloud fails instead of 502
LOCAL_FALLBACK=0
# In proxy/hybrid, answer the controller locally when the cloud has not replied after this many seconds, or replied with a 5xx error or could not be reached; 0 = off. The controller gives up after about 14 s, so keep it below that. Only the initial state: once it is changed on the settings page, the page's choice is kept in cloud-fallback.json
CLOUD_FALLBACK_SECONDS=12
# 1 = in local, still forward each report to the cloud and ignore its reply
CLOUD_MIRROR=0
# Time zone of the controller clock, for the clock sync in local mode
CONTROLLER_TZ=Europe/Warsaw

# Cloud monitoring
# Login e-mail of your Estyma cloud account; without it cloud monitoring is unavailable
ESTYMA_EMAIL=
# Password of that account
ESTYMA_PASSWORD=
# Base64 of the password, overrides ESTYMA_PASSWORD. Use it when the password starts or ends with a space, because .env files and some UIs trim those (printf ' my password' | base64)
ESTYMA_PASSWORD_B64=
# Initial on/off state, only used until it is switched in the web UI
CLOUD_MONITOR=0
# Seconds between cloud polls
CLOUD_INTERVAL=30

# MQTT / Home Assistant
# Broker host name or IP; empty = publisher off
MQTT_HOST=
# Broker port. Without compose it defaults to 8883 with MQTT_TLS=1; compose always passes 1883, so set 8883 there for TLS
MQTT_PORT=1883
# Broker login, if needed
MQTT_USER=
# Broker password, if needed
MQTT_PASSWORD=
# 1 = connect with TLS (system CA certificates)
MQTT_TLS=0
# First part of the topics
MQTT_PREFIX=estyma
# Second part of the topics and of the unique IDs; change only for a second boiler
MQTT_DEVICE_ID=boiler
# Home Assistant's discovery prefix
HA_DISCOVERY_PREFIX=homeassistant
# Seconds without a controller report until the device is unavailable. Keep it well above 100 s: after a slow or failed cloud reply the controller waits about 100 s before its next report
MQTT_STALE_SECONDS=300
# Calorific value for the energy sensor; empty = controller setting, else 4.8
FUEL_KWH_PER_KG=

# Compose / `.env` (host side)
# Host port of the proxy; the router's DNAT rule points here
PROXY_PORT=8088
